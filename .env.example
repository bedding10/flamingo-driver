# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_API_URL=https://backend-diao.onrender.com/api

# Optional. Defaults to EXPO_PUBLIC_API_URL without the /api suffix.
# EXPO_PUBLIC_SOCKET_URL=https://backend-diao.onrender.com

# Optional. development | preview | production. Defaults from __DEV__.
# EXPO_PUBLIC_ENV=development

# Native build only - provide via EAS secrets, never in git:
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
# EAS_PROJECT_ID=
