# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_API_URL=https://backend-diao.onrender.com/api

# Optional. Defaults to EXPO_PUBLIC_API_URL without the /api suffix.
# EXPO_PUBLIC_SOCKET_URL=https://backend-diao.onrender.com

# Optional. development | preview | production. Defaults from __DEV__.
# EXPO_PUBLIC_ENV=development

# Optional. Public Cloudflare R2 host for map marker artwork.
# Only set this if the bucket host changes; the default in src/config.ts already
# points at the project's existing public bucket.
# EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-7fa9666bc2604d239dd2f616f8c85a62.r2.dev

# Native build only - provide via EAS secrets, never in git:
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
# EAS_PROJECT_ID=
